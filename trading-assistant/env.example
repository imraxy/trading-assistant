# AI Trading Assistant Environment Configuration
# Copy this file to .env and fill in your actual values

# ===========================================
# Database Configuration
# ===========================================
DB_URL=postgresql://postgres:password@localhost:5432/trading_assistant
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ===========================================
# Bybit API Configuration
# ===========================================
# Get your API credentials from Bybit:
# Testnet: https://testnet.bybit.com/app/user/api-management
# Mainnet: https://www.bybit.com/app/user/api-management
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_API_SECRET=your_bybit_api_secret_here
BYBIT_TESTNET=true
BYBIT_BASE_URL=https://api-testnet.bybit.com

# ===========================================
# OpenAI API Configuration
# ===========================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=1000
OPENAI_TEMPERATURE=0.1

# ===========================================
# Application Configuration
# ===========================================
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_ANALYSIS_INTERVAL=30
APP_MAX_POSITIONS=500
APP_DATA_RETENTION_DAYS=90

# ===========================================
# Security Configuration
# ===========================================
# Generate a secure secret key for production:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECURITY_SECRET_KEY=your-secret-key-change-in-production
SECURITY_ALGORITHM=HS256
SECURITY_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Generate an encryption key for API key storage:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECURITY_ENCRYPTION_KEY=your_encryption_key_here

# ===========================================
# Environment Settings
# ===========================================
ENVIRONMENT=development

# ===========================================
# External APIs (Optional)
# ===========================================
# For sentiment analysis and news
# TWITTER_BEARER_TOKEN=your_twitter_bearer_token
# REDDIT_CLIENT_ID=your_reddit_client_id
# REDDIT_CLIENT_SECRET=your_reddit_client_secret
# CRYPTOPANIC_API_KEY=your_cryptopanic_api_key

# ===========================================
# Notification Settings (Optional)
# ===========================================
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# DISCORD_WEBHOOK_URL=your_discord_webhook_url
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=587
# EMAIL_USERNAME=your_email@gmail.com
# EMAIL_PASSWORD=your_app_password 